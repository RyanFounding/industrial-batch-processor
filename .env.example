# Copy to .env and fill in. Never commit .env.
# On Streamlit Community Cloud, set these under App settings > Secrets instead.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-2.5-flash
# Seconds between requests; 4 keeps the free tier under 15 requests per minute
REQUEST_INTERVAL_SECONDS=4
